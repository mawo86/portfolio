{
  "name": "busche-cloud",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:fast": "astro build",
    "preview": "astro preview",
    "check:types": "astro check",
    "check:style": "node scripts/check-style.mjs",
    "check:links": "node scripts/check-links.mjs dist",
    "check:budget": "node scripts/check-budget.mjs dist",
    "check": "npm run check:types && npm run check:style && npm run build && npm run check:links && npm run check:budget"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.8",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.1.6",
    "@astrojs/tailwind": "^5.1.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^4.16.0",
    "astro-og-canvas": "^0.7.2",
    "canvaskit-wasm": "^0.41.1",
    "tailwindcss": "^3.4.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  }

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Nachricht angekommen — Busche Cloud"
  description="Deine Nachricht ist da. Ich melde mich innerhalb von 24 Stunden."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
  </Fragment>
  <Header />
  <main id="main" class="min-h-[80svh] flex items-center px-6 lg:px-10 pt-36 pb-24">
    <div class="max-w-7xl mx-auto w-full">
      <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Nachricht angekommen</p>
      <h1 class="font-display font-bold text-bone-50 text-[3rem] sm:text-[4.5rem] lg:text-[5.5rem] leading-[0.94] tracking-tightest mb-8" style="text-wrap: balance;">
        Danke. Ich melde mich.
      </h1>
      <p class="text-bone-400 text-lg leading-relaxed mb-10 max-w-md">
        Innerhalb von 24 Stunden, meistens schneller. Bis dahin: Im Blog steht, wie ich über KI im Mittelstand denke. Dann weißt du vorher, mit wem du sprichst.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/blog" class="inline-flex items-center gap-2 px-6 py-3.5 bg-bone-50 text-ink-950 hover:bg-brand-300 font-semibold rounded-full transition-colors text-sm">
          Zum Blog
        </a>
        <a href="/" class="inline-flex items-center px-6 py-3.5 text-bone-50 border border-bone-50/20 hover:border-bone-50/50 font-semibold rounded-full transition-colors text-sm">
          Zur Startseite
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { terminUrl } from '../../config/site';

const studies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Projekte — Busche Cloud"
  description="Wie ein KI-Projekt bei mir abläuft: Vorgehen, Zahlen, Ergebnisse. Keine Hochglanzfolien."
>
  <Header />
  <main id="main" class="pt-36 lg:pt-44 pb-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <div class="grid lg:grid-cols-12 gap-8 mb-16">
        <div class="lg:col-span-8">
          <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Projekte</p>
          <h1 class="font-display font-bold text-bone-50 text-[3rem] sm:text-[4.2rem] leading-[0.96] tracking-tightest">
            Projekte, die laufen.
          </h1>
        </div>
        <div class="lg:col-span-4 lg:pt-14">
          <p class="text-bone-400 text-[1.05rem] leading-relaxed">
            Keine Hochglanzfolien. Vorgehen, Zahlen, und was unterwegs schiefging. Ein Teil meiner Arbeit ist NDA-gebunden. Hier steht nur, was freigegeben oder anonymisiert ist.
          </p>
        </div>
      </div>

      {studies.length === 0 ? (
        <div class="py-16 border-t border-bone-50/10">
          <p class="text-bone-200 text-lg mb-6">Die ersten Projektberichte sind in Arbeit.</p>
          <a href={terminUrl()} class="inline-flex items-center gap-2 px-5 py-3 bg-bone-50 text-ink-950 hover:bg-brand-300 font-semibold rounded-full transition-colors text-sm">
            Gespräch vereinbaren
          </a>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 gap-5">
          {studies.map(s => (
            <a href={`/case-studies/${s.slug}`} class="group block bg-ink-800 border border-bone-50/[0.06] hover:border-bone-50/20 rounded-2xl p-8 transition-colors">
              <div class="flex items-center gap-2 mb-6 text-xs text-bone-600 uppercase tracking-[0.14em] font-semibold">
                <span>{s.data.industry}</span>
                <span aria-hidden="true">·</span>
                <span>{s.data.timeframe}</span>
              </div>
              <h2 class="font-display font-semibold text-bone-50 text-[1.5rem] leading-snug tracking-tight mb-4 group-hover:text-brand-300 transition-colors" style="text-wrap: balance;">{s.data.title}</h2>
              <p class="text-bone-400 text-[0.95rem] leading-relaxed mb-7">{s.data.description}</p>
              {s.data.results.length > 0 && (
                <dl class="grid grid-cols-3 gap-4 pt-6 border-t border-bone-50/10">
                  {s.data.results.slice(0, 3).map(r => (
                    <div>
                      <dt class="font-display font-bold text-bone-50 text-[1.4rem] leading-none tracking-tight">{r.metric}</dt>
                      <dd class="text-xs text-bone-600 mt-1.5 leading-snug">{r.label}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import MediaImage from '../components/MediaImage.astro';
import { getCollection } from 'astro:content';
import { availability } from '../config/site';
import { hasMedia, mediaUrl } from '../lib/media';

const status = availability.status;
const availabilityLabel = availability.label[status];
const statusDot = status === 'available' ? 'bg-brand-400' : status === 'limited' ? 'bg-amber-300' : 'bg-bone-600';

const heroVideo = hasMedia('hero.mp4');
const heroWebm = hasMedia('hero.webm');
const heroPoster = hasMedia('hero-poster.jpg');
const kontaktStill = hasMedia('kontakt.jpg');

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const ladder = [
  {
    step: '01',
    name: 'KI-Readiness-Check',
    price: '€299',
    meta: '2 Stunden, remote',
    text: 'Zwei Stunden, ein klares Bild. Danach weißt du, was bei euch automatisierbar ist, was sich nicht lohnt und womit ihr anfangen solltet.',
    anchor: 'readiness-check',
  },
  {
    step: '02',
    name: 'KI-Pilot-Projekt',
    price: 'ab €2.500',
    meta: '4 Wochen',
    text: 'Ein Prozess, vier Wochen, ein Workflow in Produktion. Am Ende läuft etwas, das dein Team jeden Tag nutzt. Kein Prototyp in der Schublade.',
    anchor: 'pilot-projekt',
  },
  {
    step: '03',
    name: 'Laufende KI-Begleitung',
    price: 'ab €1.200/Monat',
    meta: 'ab 3 Monate',
    text: 'Ich bleibe an Bord. Weitere Workflows, Schulung fürs Team, ein Ansprechpartner, der eure Systeme kennt. Ohne ganze Beratungsmannschaft.',
    anchor: 'begleitung',
  },
];

const facts = [
  { label: 'Rolle', value: 'Global AI Manager' },
  { label: 'Erfahrung', value: '10+ Jahre Digital & ERP' },
  { label: 'Standort', value: 'Ostwestfalen-Lippe' },
  { label: 'Arbeitsweise', value: 'Remote & vor Ort' },
];

const toolGroups = [
  { category: 'KI & Sprachmodelle', tools: ['Claude', 'ChatGPT', 'Microsoft Copilot'] },
  { category: 'Automatisierung', tools: ['n8n', 'Make', 'Power Automate', 'Zapier'] },
  { category: 'Enterprise', tools: ['SAP', 'Microsoft 365', 'Azure', 'SharePoint'] },
  { category: 'Denken & Planen', tools: ['Miro', 'Obsidian', 'Notion', 'Canva'] },
];

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('de-DE', { year: 'numeric', month: 'short', day: 'numeric' }).format(date);
}
---

<Layout title="Busche Cloud — KI-Beratung für den Mittelstand">
  <Header />

  <main id="main">

  <!-- ═══ HERO ═══ -->
  <section class="relative min-h-[92svh] flex flex-col justify-end overflow-hidden" aria-labelledby="hero-heading">

    <!-- Hintergrund: Higgsfield-Video, sonst ruhiger Verlauf -->
    <div class="absolute inset-0" aria-hidden="true">
      {heroVideo ? (
        <video
          class="absolute inset-0 w-full h-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroPoster ? mediaUrl('hero-poster.jpg') : undefined}
        >
          {heroWebm && <source src={mediaUrl('hero.webm')} type="video/webm" />}
          <source src={mediaUrl('hero.mp4')} type="video/mp4" />
        </video>
      ) : heroPoster ? (
        <img src={mediaUrl('hero-poster.jpg')} alt="" class="absolute inset-0 w-full h-full object-cover" />
      ) : (
        <div class="absolute inset-0 bg-ink-950">
          <div class="absolute inset-[-10%] animate-drift will-change-transform"
               style="background:
                 radial-gradient(ellipse 55% 60% at 22% 78%, rgba(224,138,30,0.22), transparent 60%),
                 radial-gradient(ellipse 45% 50% at 78% 22%, rgba(245,241,234,0.05), transparent 65%),
                 linear-gradient(180deg, #14120F 0%, #0B0A09 100%);">
          </div>
          <div class="absolute inset-0 opacity-[0.045]" style="background-image: linear-gradient(rgba(245,241,234,0.6) 1px, transparent 1px), linear-gradient(90deg, rgba(245,241,234,0.6) 1px, transparent 1px); background-size: 64px 64px;"></div>
        </div>
      )}
      <!-- Lesbarkeit: Verlauf zum Seitengrund -->
      <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/55 to-ink-950/30"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink-950/70 via-transparent to-transparent"></div>
    </div>

    <div class="relative max-w-7xl mx-auto w-full px-6 lg:px-10 pt-40 pb-14 lg:pb-20">
      <div class="max-w-5xl">
        <div class="inline-flex items-center gap-2.5 text-[0.8rem] font-medium text-bone-200 mb-8 animate-fade-in">
          <span class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${statusDot}`}></span>
          <span class="whitespace-nowrap">{availabilityLabel}</span>
          <span class="text-bone-600 hidden sm:inline">·</span>
          <span class="text-bone-400 hidden sm:inline whitespace-nowrap">KI-Beratung für den Mittelstand</span>
        </div>

        <h1 id="hero-heading" class="font-display font-bold text-bone-50 text-[2.9rem] sm:text-[4rem] lg:text-[5rem] leading-[0.94] tracking-tightest mb-8 animate-fade-up" style="animation-delay: 0.08s;">
          KI, die bei euch wirklich&nbsp;läuft.<br />
          <span class="text-brand-300">Nicht nur auf der&nbsp;Folie.</span>
        </h1>

        <p class="text-lg sm:text-xl text-bone-200 max-w-2xl leading-relaxed mb-10 animate-fade-up" style="animation-delay: 0.18s;">
          Ich baue mit mittelständischen Unternehmen Automatisierungen, die ab Woche vier Arbeit abnehmen. Schwerpunkt: Prozesse rund um SAP in Vertrieb, Kundenservice und Backoffice. Ohne Strategiepapier für die Schublade.
        </p>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 animate-fade-up" style="animation-delay: 0.28s;">
          <a href="/#kontakt" class="inline-flex items-center gap-2 px-6 py-3.5 bg-bone-50 text-ink-950 hover:bg-brand-300 font-semibold rounded-full transition-colors text-[0.95rem]">
            Kostenloses Erstgespräch
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="/leistungen" class="inline-flex items-center gap-2 px-6 py-3.5 text-bone-50 border border-bone-50/20 hover:border-bone-50/50 font-semibold rounded-full transition-colors text-[0.95rem]">
            Pakete &amp; Preise
          </a>
        </div>
      </div>

      <!-- Proof-Leiste -->
      <dl class="mt-16 lg:mt-24 pt-6 border-t border-bone-50/10 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-6 animate-fade-up" style="animation-delay: 0.4s;">
        {facts.map(f => (
          <div>
            <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-bone-600 mb-1.5">{f.label}</dt>
            <dd class="font-display font-medium text-bone-50 text-lg leading-tight">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ═══ ÜBER MICH ═══ -->
  <section id="ueber-mich" class="py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">

        <div class="lg:col-span-5 lg:sticky lg:top-28">
          <MediaImage file="about.jpg" alt="Marlon Busche" aspect="aspect-[4/5]" class="rounded-2xl" tint="amber" />
          <p class="mt-4 text-xs text-bone-600">Marlon Busche · Global AI Manager · Ostwestfalen-Lippe</p>
        </div>

        <div class="lg:col-span-7">
          <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Über mich</p>
          <h2 class="font-display font-bold text-bone-50 text-[2.2rem] sm:text-[2.9rem] leading-[1.02] tracking-tight mb-8" style="text-wrap: balance;">
            Tagsüber Global AI Manager. Genau deshalb weiß ich, was in Produktion geht.
          </h2>
          <div class="space-y-5 text-bone-200 text-[1.05rem] leading-[1.75] max-w-2xl">
            <p>
              Ich komme aus Ostwestfalen-Lippe und arbeite seit über zehn Jahren im Digitalen. Inhouse Consultant, IT-Organisator, ERP-Auswahl, IT-Strategie. Heute verantworte ich als Global AI Manager, wie ein Unternehmen KI tatsächlich einsetzt. Nicht in Pilotfolien. Im Alltag.
            </p>
            <p>
              Das ist der Unterschied zu vielen Beratern: Ich sehe jeden Tag, welche KI-Ideen nach dem Workshop sterben und welche laufen. Diese Erfahrung bringe ich in den Mittelstand. Mit Schwerpunkt auf Prozessen rund um SAP, wo noch viel per E-Mail und Excel passiert.
            </p>
            <p>
              Ich denke Strategie und Umsetzung zusammen. Vom Prozess bis zur Schnittstelle. Und manchmal ist die ehrlichste Empfehlung: Bau das nicht. Auch das gehört dazu.
            </p>
            <p class="text-bone-400">
              Abseits davon: Familie zuerst. Dann Laufen. Dann Darts.
            </p>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href="https://linkedin.com/in/marlon-b-26203116a"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-semibold text-bone-50 hover:text-brand-300 transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Auf LinkedIn
            </a>
            <span class="text-bone-600 text-sm">·</span>
            <a href="/blog/ein-jahr-ki" class="text-sm font-semibold text-bone-50 hover:text-brand-300 transition-colors">
              Ein Jahr KI im Alltag, mein Erfahrungsbericht
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LEISTUNGEN ═══ -->
  <section id="leistungen" class="py-24 lg:py-32 border-t border-bone-50/[0.06]">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-12 gap-8 mb-14">
        <div class="lg:col-span-7">
          <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Leistungen</p>
          <h2 class="font-display font-bold text-bone-50 text-[2.2rem] sm:text-[2.9rem] leading-[1.02] tracking-tight" style="text-wrap: balance;">
            Vom ersten Blick bis zum Workflow, der läuft.
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pt-12">
          <p class="text-bone-400 text-[1.05rem] leading-relaxed">
            Drei Stufen, die aufeinander aufbauen. Du kannst bei jeder einsteigen. Feste Preise, du weißt vorher, was es kostet.
          </p>
        </div>
      </div>

      <ol class="border-t border-bone-50/10">
        {ladder.map(item => (
          <li>
            <a href={`/leistungen#${item.anchor}`} class="group grid md:grid-cols-12 gap-x-8 gap-y-3 py-8 lg:py-10 border-b border-bone-50/10 hover:bg-bone-50/[0.025] transition-colors -mx-6 px-6 lg:-mx-10 lg:px-10">
              <div class="md:col-span-1 font-mono text-sm text-bone-600 pt-1.5">{item.step}</div>
              <div class="md:col-span-4">
                <h3 class="font-display font-semibold text-bone-50 text-[1.45rem] leading-tight tracking-tight group-hover:text-brand-300 transition-colors">{item.name}</h3>
                <p class="mt-1.5 text-sm text-bone-400"><span class="text-bone-50 font-semibold">{item.price}</span> · {item.meta}</p>
              </div>
              <p class="md:col-span-6 text-bone-200 leading-relaxed text-[1rem]">{item.text}</p>
              <div class="md:col-span-1 flex md:justify-end items-start pt-1.5">
                <svg class="w-5 h-5 text-bone-600 group-hover:text-brand-300 transition-all group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6" /></svg>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <div class="mt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <p class="text-bone-400 text-sm">
          Oder punktuell: <span class="text-bone-50 font-medium">Tagessatz €1.200–1.800</span> für Workshops, Strategie-Sessions oder Umsetzung vor Ort.
        </p>
        <a href="/leistungen" class="inline-flex items-center gap-2 text-sm font-semibold text-bone-50 hover:text-brand-300 transition-colors group whitespace-nowrap">
          Alle Pakete im Detail
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ PROJEKT-ABLAUF ═══ -->
  <section id="projekte" class="py-24 lg:py-32 bg-ink-950 border-t border-bone-50/[0.06]">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-12 gap-10 items-end">
        <div class="lg:col-span-8">
          <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">So läuft ein Projekt</p>
          <h2 class="font-display font-bold text-bone-50 text-[2.2rem] sm:text-[2.9rem] lg:text-[3.4rem] leading-[1.02] tracking-tight" style="text-wrap: balance;">
            Woche&nbsp;1: Wir finden den Prozess.<br class="hidden lg:block" /> Woche&nbsp;4: Er läuft ohne mich.
          </h2>
        </div>
        <div class="lg:col-span-4 lg:pb-2">
          <p class="text-bone-400 leading-relaxed mb-6">
            Ein Beispielprojekt zeigt dir Schritt für Schritt, wie ein KI-Pilot bei mir abläuft. Von der ersten Analyse bis der Workflow im Alltag hängt.
          </p>
          <a href="/case-studies" class="inline-flex items-center gap-2 px-5 py-3 text-bone-50 border border-bone-50/20 hover:border-bone-50/50 font-semibold rounded-full transition-colors text-sm">
            Beispielprojekt ansehen
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- ═══ NEWSLETTER ═══ -->
  <section id="newsletter" class="py-24 lg:py-32 border-t border-bone-50/[0.06]">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <NewsletterSignup />
    </div>
  </section>

  <!-- ═══ TOOLS ═══ -->
  <section id="tools" class="py-24 lg:py-32 border-t border-bone-50/[0.06]">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-12 gap-8 mb-14">
        <div class="lg:col-span-7">
          <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Werkzeuge</p>
          <h2 class="font-display font-bold text-bone-50 text-[2.2rem] sm:text-[2.9rem] leading-[1.02] tracking-tight">Womit ich arbeite.</h2>
        </div>
        <div class="lg:col-span-5 lg:pt-12">
          <p class="text-bone-400 text-[1.05rem] leading-relaxed">Kein Tool-Bingo. Das hier ist bei mir wirklich im Einsatz. Was ich davon empfehle und warum, steht auf der <a href="/tools" class="text-bone-50 underline decoration-bone-50/30 underline-offset-4 hover:decoration-brand-300 transition-colors">Tools-Seite</a>.</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10 border-t border-bone-50/10 pt-10">
        {toolGroups.map(group => (
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-bone-600 mb-4">{group.category}</p>
            <ul class="space-y-2">
              {group.tools.map(tool => (
                <li class="font-display font-medium text-bone-50 text-[1.2rem] leading-snug">{tool}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ EIGENE PRODUKTE ═══ -->
  <section id="produkte" class="py-24 lg:py-32 border-t border-bone-50/[0.06]">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-12 gap-8 mb-14">
        <div class="lg:col-span-7">
          <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Eigene Produkte</p>
          <h2 class="font-display font-bold text-bone-50 text-[2.2rem] sm:text-[2.9rem] leading-[1.02] tracking-tight">Selbst gebaut. Selbst im Einsatz.</h2>
        </div>
        <div class="lg:col-span-5 lg:pt-12">
          <p class="text-bone-400 text-[1.05rem] leading-relaxed">Ich berate nicht nur zu KI. Ich baue damit. Zwei Apps, die live laufen und zahlende Nutzer haben. Das hält den Blick ehrlich.</p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        <a href="https://cookloop.vercel.app" target="_blank" rel="noopener noreferrer" class="group relative bg-ink-800 rounded-2xl p-8 lg:p-10 border border-bone-50/[0.06] hover:border-bone-50/20 transition-colors overflow-hidden">
          <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-emerald-400/10 blur-3xl group-hover:bg-emerald-400/15 transition-colors" aria-hidden="true"></div>
          <div class="relative">
            <div class="flex items-center justify-between mb-8">
              <span class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-emerald-300/80">KI-Essensplanung</span>
              <span class="inline-flex items-center gap-1.5 text-xs text-bone-400"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Live</span>
            </div>
            <h3 class="font-display font-bold text-bone-50 text-[2rem] leading-none tracking-tight mb-4 group-hover:text-brand-300 transition-colors">Cookloop</h3>
            <p class="text-bone-200 text-[1.05rem] leading-relaxed mb-6">Wochenpläne, die Zutaten weiterverwenden statt wegwerfen. Claude plant im Hintergrund, deine Vorlieben entscheiden. Nachhaltigkeit als Funktion, nicht als Motto.</p>
            <p class="text-sm text-bone-400 mb-8">Next.js · Claude API · Supabase · Stripe</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-bone-50">
              App öffnen
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </div>
        </a>

        <a href="https://dartsiq.vercel.app" target="_blank" rel="noopener noreferrer" class="group relative bg-ink-800 rounded-2xl p-8 lg:p-10 border border-bone-50/[0.06] hover:border-bone-50/20 transition-colors overflow-hidden">
          <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-red-400/10 blur-3xl group-hover:bg-red-400/15 transition-colors" aria-hidden="true"></div>
          <div class="relative">
            <div class="flex items-center justify-between mb-8">
              <span class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-red-300/80">Darts-Training &amp; Analyse</span>
              <span class="inline-flex items-center gap-1.5 text-xs text-bone-400"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>Live MVP</span>
            </div>
            <h3 class="font-display font-bold text-bone-50 text-[2rem] leading-none tracking-tight mb-4 group-hover:text-brand-300 transition-colors">DartsIQ</h3>
            <p class="text-bone-200 text-[1.05rem] leading-relaxed mb-6">Wer die Doppel trifft, gewinnt. DartsIQ zeigt dir per Heatmap, warum du sie verfehlst. Sechs Trainingsspiele, Turnierverwaltung, KI-Auswertung. Freemium mit Stripe.</p>
            <p class="text-sm text-bone-400 mb-8">Next.js · Supabase · Stripe · Recharts · Claude API</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-bone-50">
              App öffnen
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ BLOG ═══ -->
  {posts.length > 0 && (
    <section id="blog" class="py-24 lg:py-32 border-t border-bone-50/[0.06]">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <div class="flex items-end justify-between gap-6 mb-12">
          <div>
            <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Blog</p>
            <h2 class="font-display font-bold text-bone-50 text-[2.2rem] sm:text-[2.9rem] leading-[1.02] tracking-tight">Aus der Praxis.</h2>
          </div>
          <a href="/blog" class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-bone-50 hover:text-brand-300 transition-colors group whitespace-nowrap">
            Alle Artikel
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>

        <div class="border-t border-bone-50/10">
          {posts.map(post => (
            <a href={`/blog/${post.slug}`} class="group grid md:grid-cols-12 gap-x-8 gap-y-2 py-7 border-b border-bone-50/10 hover:bg-bone-50/[0.025] transition-colors -mx-6 px-6 lg:-mx-10 lg:px-10">
              <div class="md:col-span-3 flex md:flex-col gap-x-3 gap-y-1 text-xs text-bone-600 pt-1">
                <span class="text-brand-400 font-semibold uppercase tracking-wider">{post.data.category}</span>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </div>
              <div class="md:col-span-8">
                <h3 class="font-display font-semibold text-bone-50 text-[1.35rem] leading-snug tracking-tight group-hover:text-brand-300 transition-colors mb-2">{post.data.title}</h3>
                <p class="text-bone-400 text-[0.95rem] leading-relaxed line-clamp-2">{post.data.description}</p>
              </div>
              <div class="hidden md:flex md:col-span-1 justify-end pt-1">
                <svg class="w-5 h-5 text-bone-600 group-hover:text-brand-300 transition-all group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6" /></svg>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 sm:hidden">
          <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-bone-50 hover:text-brand-300 transition-colors">
            Alle Artikel
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ═══ KONTAKT ═══ -->
  <section id="kontakt" class="relative py-24 lg:py-32 border-t border-bone-50/[0.06] overflow-hidden">
    {kontaktStill && (
      <div class="absolute inset-0" aria-hidden="true">
        <img src={mediaUrl('kontakt.jpg')} alt="" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover opacity-40" />
        <div class="absolute inset-0 bg-gradient-to-b from-ink-900 via-ink-900/80 to-ink-900"></div>
      </div>
    )}
    <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">

        <div class="lg:col-span-5">
          <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Kontakt</p>
          <h2 class="font-display font-bold text-bone-50 text-[2.2rem] sm:text-[2.9rem] lg:text-[3.4rem] leading-[1.02] tracking-tight mb-6" style="text-wrap: balance;">
            Lass uns 30 Minuten reden.
          </h2>
          <p class="text-bone-200 text-[1.05rem] leading-relaxed mb-8 max-w-md">
            Schreib mir kurz, worum es geht. Ich antworte innerhalb von 24 Stunden, meistens schneller. Kein Verkaufsgespräch, versprochen. Wenn es nicht passt, sage ich das auch.
          </p>
          <dl class="space-y-4 text-sm">
            <div class="flex gap-4">
              <dt class="w-24 text-bone-600 flex-shrink-0">Antwort</dt>
              <dd class="text-bone-50">innerhalb von 24 Stunden</dd>
            </div>
            <div class="flex gap-4">
              <dt class="w-24 text-bone-600 flex-shrink-0">Erstgespräch</dt>
              <dd class="text-bone-50">30 Minuten, kostenlos, remote</dd>
            </div>
            <div class="flex gap-4">
              <dt class="w-24 text-bone-600 flex-shrink-0">Direkt</dt>
              <dd><a href="https://linkedin.com/in/marlon-b-26203116a" target="_blank" rel="noopener noreferrer" class="text-bone-50 hover:text-brand-300 transition-colors underline decoration-bone-50/30 underline-offset-4">LinkedIn-Nachricht</a></dd>
            </div>
          </dl>
        </div>

        <div class="lg:col-span-7">
          <div class="bg-ink-800/90 backdrop-blur border border-bone-50/[0.08] rounded-2xl p-7 sm:p-10">
            <form
              action="https://formspree.io/f/xgopevdy"
              method="POST"
              class="space-y-6"
              aria-label="Kontaktformular"
            >
              <input type="hidden" name="_next" value="https://busche.cloud/danke" />
              <input type="text" name="_gotcha" style="display:none !important" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <input type="hidden" name="_timestamp" id="formTimestamp" value="" />

              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-bone-400 mb-2.5" for="name">Name</label>
                  <input type="text" id="name" name="name" required placeholder="Max Mustermann"
                    class="w-full px-0 py-3 bg-transparent border-0 border-b border-bone-50/20 focus:border-brand-400 text-bone-50 placeholder-bone-600 text-base outline-none transition-colors rounded-none" />
                </div>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-bone-400 mb-2.5" for="email">E-Mail</label>
                  <input type="email" id="email" name="email" required placeholder="max@unternehmen.de"
                    class="w-full px-0 py-3 bg-transparent border-0 border-b border-bone-50/20 focus:border-brand-400 text-bone-50 placeholder-bone-600 text-base outline-none transition-colors rounded-none" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-bone-400 mb-2.5" for="subject">Worum geht es?</label>
                <select id="subject" name="subject" required
                  class="w-full px-0 py-3 bg-transparent border-0 border-b border-bone-50/20 focus:border-brand-400 text-bone-50 text-base outline-none transition-colors appearance-none rounded-none cursor-pointer">
                  <option value="" class="bg-ink-800" disabled selected>Bitte wählen</option>
                  <option value="readiness-check" class="bg-ink-800">KI-Readiness-Check</option>
                  <option value="pilot-projekt" class="bg-ink-800">KI-Pilot-Projekt</option>
                  <option value="laufende-begleitung" class="bg-ink-800">Laufende KI-Begleitung</option>
                  <option value="tagessatz" class="bg-ink-800">Tagessatz / Workshop</option>
                  <option value="sonstiges" class="bg-ink-800">Etwas anderes</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-bone-400 mb-2.5" for="message">Nachricht</label>
                <textarea id="message" name="message" required rows="4" placeholder="Zwei, drei Sätze reichen: Was macht euer Unternehmen, und wo drückt es gerade?"
                  class="w-full px-0 py-3 bg-transparent border-0 border-b border-bone-50/20 focus:border-brand-400 text-bone-50 placeholder-bone-600 text-base outline-none transition-colors resize-none rounded-none"></textarea>
              </div>

              <div class="flex items-start gap-3 pt-2">
                <input type="checkbox" id="consent" name="consent" required class="mt-1 w-4 h-4 flex-shrink-0 accent-brand-500 cursor-pointer" />
                <label for="consent" class="text-xs text-bone-400 leading-relaxed cursor-pointer">
                  Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden. Details in der <a href="/datenschutz" class="text-bone-200 hover:text-brand-300 underline underline-offset-2 transition-colors">Datenschutzerklärung</a>.
                </label>
              </div>

              <button type="submit"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-bone-50 text-ink-950 hover:bg-brand-300 font-semibold rounded-full transition-colors text-[0.95rem] disabled:opacity-50 disabled:cursor-not-allowed">
                Nachricht senden
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  </main>

  <Footer />
</Layout>

<script>
  const loadTime = Date.now();
  const tsField = document.getElementById('formTimestamp') as HTMLInputElement | null;
  if (tsField) tsField.value = String(loadTime);

  const form = document.querySelector('form[action*="formspree"]') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      if (Date.now() - loadTime < 3000) {
        e.preventDefault();
        return;
      }
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Wird gesendet…';
      }
    });
  }
</script>

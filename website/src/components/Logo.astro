---
// Wortmarke Busche Cloud. Inline-SVG, kein Bild-Request.
// Das Zeichen: ein geometrisches B als Monolinie auf Amber. Ruhig, technisch, ohne Wolke.
export interface Props {
  size?: 'sm' | 'md';
  class?: string;
}
const { size = 'md', class: className = '' } = Astro.props;
const px = size === 'sm' ? 32 : 38;
const uid = 'lg' + Math.random().toString(36).slice(2, 7);
---

<a href={import.meta.env.BASE_URL} class={`inline-flex items-center gap-3 group ${className}`} aria-label="Busche Cloud, zur Startseite">
  <svg width={px} height={px} viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id={uid} x1="4" y1="4" x2="36" y2="36" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#F2A84A"/>
        <stop offset="1" stop-color="#D47A12"/>
      </linearGradient>
    </defs>
    <rect width="40" height="40" rx="11" fill={`url(#${uid})`}/>
    <path d="M13.5 9.5V30.5" stroke="#121110" stroke-width="4.6" stroke-linecap="round"/>
    <path d="M13.5 9.5H21.5A5.25 5.25 0 0 1 21.5 20H13.5" stroke="#121110" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M13.5 20H23A5.25 5.25 0 0 1 23 30.5H13.5" stroke="#121110" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="flex items-baseline gap-1.5 font-display leading-none">
    <span class={`font-bold tracking-tight text-bone-50 ${size === 'sm' ? 'text-[1.05rem]' : 'text-[1.25rem]'}`}>Busche</span>
    <span class={`font-medium text-bone-400 group-hover:text-brand-300 transition-colors ${size === 'sm' ? 'text-[0.95rem]' : 'text-[1.1rem]'}`}>Cloud</span>
  </span>
</a>

---
import Logo from './Logo.astro';
import { terminUrl } from '../config/site';

const BASE = import.meta.env.BASE_URL;
const navLinks = [
  { href: `${BASE}loesungen`, label: 'Lösungen' },
  { href: `${BASE}leistungen`, label: 'Leistungen' },
  { href: `${BASE}case-studies`, label: 'Projekte' },
  { href: `${BASE}blog`, label: 'Blog' },
  { href: `${BASE}tools`, label: 'Tools' },
  { href: `${BASE}#ueber-mich`, label: 'Über mich' },
];

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  const clean = href.replace(BASE, '/').split('#')[0];
  return clean !== '/' && currentPath.startsWith(clean);
}
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-colors duration-300">
  <div class="absolute inset-0 bg-ink-900/0 backdrop-blur-0 transition-all duration-300 border-b border-transparent" id="header-bg"></div>
  <nav class="relative max-w-7xl mx-auto px-6 lg:px-10 h-[4.5rem] flex items-center justify-between" aria-label="Hauptnavigation">
    <Logo />

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-7">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class={`text-[0.9rem] font-medium transition-colors relative group ${isActive(link.href) ? 'text-bone-50' : 'text-bone-400 hover:text-bone-50'}`}
          >
            {link.label}
            <span class={`absolute -bottom-1 left-0 h-px bg-brand-400 transition-all duration-300 ${isActive(link.href) ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <a
      href={terminUrl()}
      data-track="paket_cta_geklickt" data-track-label="header"
      class="hidden md:inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-brand-600 text-white hover:bg-brand-700 rounded-full transition-colors"
    >
      Erstgespräch
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 -mr-2 text-bone-200 hover:text-bone-50 transition-colors"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="mobile-menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="mobile-menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-bone-50/10 bg-ink-900/95 backdrop-blur-xl">
    <ul class="max-w-7xl mx-auto px-6 py-5 flex flex-col gap-1">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="block py-3 px-3 text-bone-200 hover:text-bone-50 hover:bg-bone-50/5 rounded-lg transition-colors text-base font-display font-medium">
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-3 pt-3 border-t border-bone-50/10">
        <a href={terminUrl()} data-track="paket_cta_geklickt" data-track-label="header-mobil" class="block py-3 px-3 text-center bg-brand-600 text-white hover:bg-brand-700 rounded-full text-sm font-semibold transition-colors">
          Erstgespräch buchen
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const headerBg = document.getElementById('header-bg');

  function onScroll() {
    const scrolled = window.scrollY > 24;
    headerBg?.classList.toggle('!bg-ink-900/85', scrolled);
    headerBg?.classList.toggle('!backdrop-blur-xl', scrolled);
    headerBg?.classList.toggle('!border-bone-50/[0.06]', scrolled);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  function setMenuOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    if (open) headerBg?.classList.add('!bg-ink-900/85', '!backdrop-blur-xl');
    else onScroll();
  }

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    setMenuOpen(!!isHidden);
  });

  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      setMenuOpen(false);
      btn?.focus();
    }
  });
</script>

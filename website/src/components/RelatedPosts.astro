---
import { getCollection } from 'astro:content';

export interface Props {
  currentSlug: string;
  category: string;
}

const { currentSlug, category } = Astro.props;

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter(p => p.slug !== currentSlug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sameCategory = allPosts.filter(p => p.data.category === category);
const rest = allPosts.filter(p => p.data.category !== category);
const related = [...sameCategory, ...rest].slice(0, 3);
---

{related.length > 0 && (
  <nav class="mt-12 pt-10 border-t border-white/10" aria-label="Weitere Artikel">
    <p class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-6">Weiterlesen</p>
    <div class="grid sm:grid-cols-3 gap-5">
      {related.map(post => (
        <a href={`${import.meta.env.BASE_URL}blog/${post.slug}`} class="group block bg-white/3 hover:bg-white/5 border border-white/8 hover:border-white/15 rounded-xl p-5 transition-all duration-300">
          <span class="text-xs text-brand-400 font-medium">{post.data.category}</span>
          <h4 class="text-sm font-bold text-white mt-2 mb-1 leading-snug group-hover:text-brand-300 transition-colors line-clamp-2">
            {post.data.title}
          </h4>
        </a>
      ))}
    </div>
  </nav>
)}

---
import { getCollection } from 'astro:content';

export interface Props {
  currentSlug: string;
  category: string;
}

const { currentSlug, category } = Astro.props;

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter(p => p.slug !== currentSlug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sameCategory = allPosts.filter(p => p.data.category === category);
const rest = allPosts.filter(p => p.data.category !== category);
const related = [...sameCategory, ...rest].slice(0, 3);
---

{related.length > 0 && (
  <nav class="mt-14 pt-10 border-t border-bone-50/10" aria-label="Weitere Artikel">
    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-brand-400 mb-6">Weiterlesen</p>
    <div class="grid sm:grid-cols-3 gap-5">
      {related.map(post => (
        <a href={`${import.meta.env.BASE_URL}blog/${post.slug}`} class="group block bg-ink-800 border border-bone-50/[0.06] hover:border-bone-50/20 rounded-2xl p-5 transition-colors">
          <span class="text-xs text-bone-600 font-semibold uppercase tracking-wider">{post.data.category}</span>
          <h4 class="font-display font-semibold text-bone-50 text-[1.05rem] mt-2 leading-snug tracking-tight group-hover:text-brand-300 transition-colors line-clamp-3">
            {post.data.title}
          </h4>
        </a>
      ))}
    </div>
  </nav>
)}

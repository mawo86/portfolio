---
// Testimonials. Sobald echte Zitate vorhanden sind, hier ergänzen
// (Interview-Leitfaden: outputs/testimonial-vorlage.md).
// Solange die Liste leer ist, rendert die Komponente nichts.
type Testimonial = {
  quote: string;
  name: string;
  role: string;
  source?: 'LinkedIn' | 'Projekt' | 'Workshop';
};

const testimonials: Testimonial[] = [
  // {
  //   quote: 'Marlon hat unseren Angebotsprozess von vier Tagen auf zwei Stunden gebracht.',
  //   name: 'Vorname Nachname',
  //   role: 'Geschäftsführer · Firma',
  //   source: 'Projekt',
  // },
];
---

{testimonials.length > 0 && (
  <section id="stimmen" class="py-24 lg:py-32 border-t border-bone-50/[0.06]">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Stimmen</p>
      <h2 class="font-display font-bold text-bone-50 text-[2.2rem] sm:text-[2.9rem] leading-[1.02] tracking-tight mb-14">Was Kunden sagen.</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {testimonials.map(t => (
          <figure class="bg-ink-800 border border-bone-50/[0.06] rounded-2xl p-7 flex flex-col">
            <blockquote class="font-display font-medium text-bone-50 text-[1.25rem] leading-snug tracking-tight mb-8 flex-1">
              „{t.quote}“
            </blockquote>
            <figcaption class="flex items-center gap-3 pt-5 border-t border-bone-50/10">
              <div class="w-9 h-9 rounded-full bg-brand-600 text-white flex items-center justify-center text-sm font-bold flex-shrink-0">
                {t.name.split(' ').map(p => p[0]).join('').slice(0,2)}
              </div>
              <div>
                <div class="text-bone-50 text-sm font-semibold">{t.name}</div>
                <div class="text-bone-600 text-xs">{t.role}</div>
              </div>
              {t.source && (
                <span class="ml-auto text-[0.6rem] font-bold uppercase tracking-[0.14em] text-bone-600">{t.source}</span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

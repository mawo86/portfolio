---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
const BASE = import.meta.env.BASE_URL;
---

<footer class="relative bg-ink-950 border-t border-bone-50/[0.06]" role="contentinfo">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 pt-16 pb-10">
    <div class="grid md:grid-cols-12 gap-12 md:gap-8">

      <!-- Brand -->
      <div class="md:col-span-5">
        <Logo size="sm" />
        <p class="mt-5 text-bone-400 text-[0.95rem] leading-relaxed max-w-sm">
          KI-Beratung für den Mittelstand. Aus Ostwestfalen-Lippe, remote überall. Feste Pakete, feste Preise, Workflows, die nach Woche vier noch laufen.
        </p>
        <a
          href={`${BASE}#kontakt`}
          class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-bone-50 hover:text-brand-300 transition-colors group"
        >
          Erstgespräch buchen
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <!-- Links -->
      <div class="md:col-span-7 grid grid-cols-2 gap-8">
        <div>
          <p class="text-[0.7rem] font-semibold text-bone-600 uppercase tracking-[0.18em] mb-4">Seiten</p>
          <ul class="flex flex-col gap-2.5">
            <li><a href={`${BASE}leistungen`} class="text-sm text-bone-400 hover:text-bone-50 transition-colors">Leistungen &amp; Preise</a></li>
            <li><a href={`${BASE}case-studies`} class="text-sm text-bone-400 hover:text-bone-50 transition-colors">Projekte</a></li>
            <li><a href={`${BASE}blog`} class="text-sm text-bone-400 hover:text-bone-50 transition-colors">Blog</a></li>
            <li><a href={`${BASE}tools`} class="text-sm text-bone-400 hover:text-bone-50 transition-colors">Tools</a></li>
            <li><a href={`${BASE}#ueber-mich`} class="text-sm text-bone-400 hover:text-bone-50 transition-colors">Über mich</a></li>
          </ul>
        </div>
        <div>
          <p class="text-[0.7rem] font-semibold text-bone-600 uppercase tracking-[0.18em] mb-4">Kontakt</p>
          <ul class="flex flex-col gap-2.5">
            <li><a href={`${BASE}#kontakt`} class="text-sm text-bone-400 hover:text-bone-50 transition-colors">Anfrage stellen</a></li>
            <li><a href="https://linkedin.com/in/marlon-b-26203116a" target="_blank" rel="noopener noreferrer" class="text-sm text-bone-400 hover:text-bone-50 transition-colors">LinkedIn</a></li>
            <li><a href={`${BASE}#newsletter`} class="text-sm text-bone-400 hover:text-bone-50 transition-colors">Newsletter</a></li>
            <li>
              <a href="/rss.xml" target="_blank" class="text-sm text-bone-400 hover:text-bone-50 transition-colors inline-flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg>
                RSS
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-bone-50/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-bone-600">© {year} Busche Cloud · Marlon Busche · Ostwestfalen-Lippe</p>
      <div class="flex gap-5">
        <a href={`${BASE}impressum`} class="text-xs text-bone-600 hover:text-bone-200 transition-colors">Impressum</a>
        <a href={`${BASE}datenschutz`} class="text-xs text-bone-600 hover:text-bone-200 transition-colors">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>

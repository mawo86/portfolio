---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { terminUrl } from '../config/site';

export interface Props {
  title: string;
  description: string;
  client: string;
  industry: string;
  timeframe: string;
  role: string;
  services: string[];
  results: { metric: string; label: string }[];
}

const { title, description, client, industry, timeframe, role, services, results } = Astro.props;
const slug = Astro.url.pathname.replace(/^\/case-studies\//, '').replace(/\/$/, '');
const ogRoute = `case-studies/${slug}`;
---

<Layout title={`${title} — Case Study — Busche Cloud`} description={description} ogRoute={ogRoute}>
  <Header />
  <main id="main" class="pt-36 lg:pt-44 pb-24">
    <article class="max-w-4xl mx-auto px-6">
      <a href="/case-studies" class="inline-flex items-center gap-2 text-bone-600 hover:text-bone-50 text-sm mb-10 transition-colors group">
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        Alle Projekte
      </a>

      <p class="text-brand-400 text-[0.75rem] font-semibold uppercase tracking-[0.2em] mb-5">Projekt</p>
      <h1 class="font-display font-bold text-bone-50 text-[2.3rem] sm:text-[3rem] lg:text-[3.5rem] leading-[1.02] tracking-tight mb-6" style="text-wrap: balance;">{title}</h1>
      <p class="text-bone-400 text-[1.15rem] leading-relaxed mb-12 max-w-3xl">{description}</p>

      <!-- Meta -->
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-6 py-8 border-y border-bone-50/10 mb-12">
        {[
          { label: 'Kunde', value: client },
          { label: 'Branche', value: industry },
          { label: 'Zeitraum', value: timeframe },
          { label: 'Rolle', value: role },
        ].map(item => (
          <div>
            <dt class="text-[0.7rem] text-bone-600 uppercase tracking-[0.18em] font-semibold mb-1.5">{item.label}</dt>
            <dd class="text-sm text-bone-50 font-medium leading-snug">{item.value}</dd>
          </div>
        ))}
      </dl>

      <!-- Ergebnisse -->
      {results.length > 0 && (
        <dl class="grid sm:grid-cols-3 gap-5 mb-16">
          {results.map(r => (
            <div class="bg-ink-800 border border-bone-50/[0.06] rounded-2xl p-7">
              <dt class="font-display font-bold text-bone-50 text-[2.6rem] leading-none tracking-tight mb-2">{r.metric}</dt>
              <dd class="text-sm text-bone-400 leading-snug">{r.label}</dd>
            </div>
          ))}
        </dl>
      )}

      <!-- Body -->
      <div class="prose max-w-none
        prose-p:text-bone-200 prose-p:leading-[1.9] prose-p:text-[1.05rem]
        prose-h2:text-bone-50 prose-h2:font-display prose-h2:font-bold prose-h2:text-[1.8rem] prose-h2:mt-16 prose-h2:mb-6 prose-h2:tracking-tight
        prose-h3:text-bone-50 prose-h3:font-display prose-h3:font-semibold prose-h3:text-[1.3rem]
        prose-strong:text-bone-50
        prose-a:text-bone-50 prose-a:no-underline prose-a:border-b prose-a:border-brand-400/50 hover:prose-a:text-brand-300
        prose-blockquote:border-l-2 prose-blockquote:border-brand-400 prose-blockquote:bg-ink-800 prose-blockquote:rounded-r-2xl
        prose-blockquote:px-7 prose-blockquote:py-5 prose-blockquote:not-italic prose-blockquote:text-bone-50
        prose-li:text-bone-200 prose-li:marker:text-brand-400
      ">
        <slot />
      </div>

      <!-- Service-Tags -->
      {services.length > 0 && (
        <div class="mt-14 flex flex-wrap gap-2">
          {services.map(s => (
            <span class="px-3 py-1.5 text-xs font-medium text-bone-200 border border-bone-50/15 rounded-full">{s}</span>
          ))}
        </div>
      )}

      <!-- CTA -->
      <div class="mt-14 p-7 sm:p-8 bg-ink-800 border border-brand-500/25 rounded-2xl">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-brand-400 mb-2.5">Ähnlicher Fall bei dir?</p>
        <h3 class="font-display font-semibold text-bone-50 text-[1.35rem] leading-tight tracking-tight mb-2">Lass uns 30 Minuten darüber reden.</h3>
        <p class="text-bone-400 text-sm leading-relaxed mb-5">Kostenloses Erstgespräch, kein Verkauf. Wir schauen, ob und wie es bei dir passt.</p>
        <a href={terminUrl()} class="inline-flex items-center gap-2 px-5 py-3 bg-brand-600 text-white hover:bg-brand-700 font-semibold rounded-full transition-colors text-sm">
          Gespräch vereinbaren
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
